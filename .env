# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:8080

# Database Configuration
# For PostgreSQL (Production)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=contact_form
DB_USER=your_db_user
DB_PASS=your_db_password
DB_SSL=false

# SQLite is used by default for development
# No additional DB config needed for SQLite

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Admin Email (where contact forms will be sent)
ADMIN_EMAIL=

# Example configurations for different email providers:

# Gmail:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# Use app-specific password, not your regular Gmail password

# Outlook/Hotmail:
# SMTP_HOST=smtp-mail.outlook.com
# SMTP_PORT=587

# Yahoo:
# SMTP_HOST=smtp.mail.yahoo.com
# SMTP_PORT=587

# Custom SMTP (like cPanel hosting):
# SMTP_HOST=mail.yourdomain.com
# SMTP_PORT=587
