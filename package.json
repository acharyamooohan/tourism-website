{
  "name": "nepal-tourism-website",
  "version": "1.0.0",
  "description": "Production-ready Nepal Tourism Website with comprehensive destination database and contact system",
  "main": "server-production.js",
  "scripts": {
    "start": "node server-production.js",
    "dev": "NODE_ENV=development nodemon server-production.js",
    "production": "NODE_ENV=production node server-production.js",
    "build": "npm install --production",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint *.js",
    "lint:fix": "eslint *.js --fix",
    "db:migrate": "sequelize-cli db:migrate",
    "db:seed": "sequelize-cli db:seed:all",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop nepal-tourism",
    "pm2:restart": "pm2 restart nepal-tourism",
    "pm2:logs": "pm2 logs nepal-tourism"
  },
  "keywords": [
    "nepal",
    "tourism",
    "travel",
    "destinations",
    "nodejs",
    "express",
    "contact-form",
    "production-ready"
  ],
  "author": "Nepal Tourism Team",
  "license": "MIT",
  "dependencies": {
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.2.0",
    "morgan": "^1.10.1",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.35.1",
    "sqlite3": "^5.1.6"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.2",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/nepal-tourism-website.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/nepal-tourism-website/issues"
  },
  "homepage": "https://your-domain.com"
}
